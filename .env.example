# Copy to .env and fill in. .env is gitignored and never committed.

# --- neatlogs (required) ---
# Write key from https://app.neatlogs.com — ingest-only, can POST traces but never read back.
NEATLOGS_WRITE_KEY=
# Project NAME. Required: a write key identifies a user, not a project.
NEATLOGS_PROJECT=neathack
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com

# --- LLM (AWS Bedrock) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- search ---
VERBATIM_SEARCH=brave
BRAVE_SEARCH_API_KEY=

# --- runtime ---
# corpus = deterministic seeded sources (default). live = real web retrieval.
VERBATIM_RETRIEVAL=corpus
VERBATIM_DB=./var/verbatim.db
VERBATIM_BIND=0.0.0.0:8080
VERBATIM_MAX_RUN_SECONDS=600
VERBATIM_MAX_RUN_CENTS=25
