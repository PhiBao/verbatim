  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "compatibility:validate": "node scripts/compatibility/discover-releases.mjs --validate-only",
    "compatibility:test": "node --test scripts/compatibility/*.test.mjs",
    "compatibility:discover": "node scripts/compatibility/discover-releases.mjs --report=compatibility-release-report.json",
    "compatibility:evidence": "node scripts/compatibility/analyze-upstream.mjs --release-report=compatibility-release-report.json --evidence=compatibility-evidence.json",
    "compatibility:llm": "node scripts/compatibility/analyze-upstream.mjs --evidence=compatibility-evidence.json --llm-output=compatibility-llm-analysis.json --llm-only",
    "compatibility:consumer": "node scripts/compatibility/verify-package-manager.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "tsup && rm -f dist/*.d.mts",
    "pretest": "npm run build",
    "prepack": "npm run build && node scripts/verify-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "dev": "tsup --watch",
    "example:openai": "tsx examples/openai_multiagent/main.ts",
    "example:anthropic": "tsx examples/anthropic_multiagent/main.ts",
    "example:google": "tsx examples/google_genai_multiagent/main.ts",
    "example:langchain": "tsx examples/langchain_react/main.ts",
    "example:langgraph": "tsx examples/langgraph_multiagent/main.ts",
    "example:marketing": "tsx examples/marketing_strategy_demo/main.ts",
    "example:reasoning": "tsx examples/reasoning_model_workflow/main.ts",
    "example:azure-openai": "tsx examples/sdk_examples/azure_openai_basic/main.ts",
    "example:vertex-ai": "tsx examples/sdk_examples/vertex_ai_basic/main.ts",
    "example:google-genai": "tsx examples/sdk_examples/google_genai_basic/main.ts",
    "example:bedrock": "tsx examples/sdk_examples/bedrock_basic/main.ts",
    "example:openrouter": "tsx examples/sdk_examples/openrouter_agent_basic/main.ts",
    "example:pi-agent": "tsx examples/pi_agent_workflow/main.mts",
    "example:pi-agent:surface": "tsx examples/pi_agent_workflow/surface.mts",
    "test:examples:original7": "node scripts/run-original7-examples.mjs",
    "verify:logs": "node scripts/verify-original7-logs.mjs"
  },
  "keywords": [
    "observability",
    "tracing",
    "opentelemetry",
    "llm",
    "ai",
    "agents",
    "debugging"
  ],
  "license": "MIT",
  "dependencies": {
