# --- secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- rust ---
/target
**/*.rs.bk
*.pdb

# --- node ---
/node_modules
/web/node_modules
/web/.next
/web/out
/web/build
