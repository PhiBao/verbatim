# --- private working instructions (never publish) ---
# These define how the agent operates on this repo. They are not part of the
# product and were purged from history, so they must never be re-added.
AGENTS.md
FOUNDER.md

# --- secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- rust ---
/target
**/*.rs.bk
*.pdb

# --- node ---
# A bare pattern, so it applies at any depth. The plugin directory previously
# had 9,344 node_modules files committed, which is why they all showed as
# deleted the moment the directory moved.
node_modules/
/web/.next
/web/out
/web/build
.pnpm-store

# --- dataset / runtime artifacts that are regenerated ---
/var
/corpus/cache

# --- os / editor ---
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# --- misc ---
*.log
/tmp
